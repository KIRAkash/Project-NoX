# ============================================================
# NoX — environment. Copy to .env and fill in.
# Keys marked (required) must be set for the API to start.
# ============================================================

# ── AI: Google ADK agents on Gemini, optional local Gemma ───
# Backend: enterprise = Gemini Enterprise Agent Platform (Vertex AI) with your GCP credentials
# (gcloud auth application-default login, or GOOGLE_APPLICATION_CREDENTIALS); api_key = GEMINI_API_KEY;
# local = Gemma via Ollama (NoX Local). Empty picks enterprise when GCP_PROJECT_ID is set.
NOX_AI_BACKEND=
GCP_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=                         # only for NOX_AI_BACKEND=api_key
GEMINI_MODEL=gemini-3.7-flash           # default tier: pages, specs, answers
GEMINI_BACKUP_MODEL=gemini-3.5-flash    # used automatically if the primary fails
NOX_MODEL_FAST=gemini-3.5-flash-lite    # gatekeeper and small structured calls (empty = GEMINI_MODEL)
NOX_MODEL_DEEP=                         # architecture map + org rollup, e.g. gemini-3.1-pro-preview
NOX_EMBED_MODEL=gemini-embedding-2      # KB search (768 dims, pgvector)
NOX_EMBEDDINGS=true
NOX_MAX_CONCURRENCY=8
NOX_KB_WORKFLOW=graph                   # KB builder as an ADK workflow graph; linear = the older orchestration
NOX_REVIEW_ROUNDS=2                     # quality gate ⇄ reviewer rounds per build
NOX_CONTEXT_CACHE=true                  # explicit context caches for Ask and co-writer (not in local mode)
NOX_LOCAL_MODEL=ollama_chat/gemma4:12b  # NoX Local (Gemma 4 on Ollama)
AI_MODE=remote                          # legacy engine routing: remote | local | hybrid
GEMINI_RATE_LIMIT_SAFE_MODE=true
GEMINI_MAX_CONCURRENCY=2
GEMINI_REQUEST_DELAY_SECONDS=2.0
GEMMA_OLLAMA_URL=http://localhost:11434 # only for local / hybrid
GEMMA_MODEL=gemma3

# ── GitHub App (KB repos, PRs, webhooks) ────────────────────
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-key.pem
# GITHUB_APP_PRIVATE_KEY=               # or inline PEM with \n
GITHUB_APP_SLUG=nox-gitops
GITHUB_APP_TOKEN=                       # optional PAT fallback
GITHUB_DEFAULT_ORG=                     # org where kb-<app> repos are created

# ── Infra ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nox
REDIS_URL=redis://localhost:6379/0
WORKER_MODE=auto                        # auto | celery | in_process
STORAGE_BACKEND=local                   # local | gcs
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=         # service-account JSON path (GCS)
SOURCE_MONITOR_MODE=webhook             # webhook | polling
WEBHOOK_SECRET=                         # (required) random string, HMAC for GitHub webhooks

# ── Public URL (needed for two-way Jira + GitHub webhooks) ──
# 1. Run the API:    make api            (port 8000)
# 2. Open a tunnel:  cloudflared tunnel --url http://localhost:8000
#                    (or: ngrok http 8000)
# 3. Paste the https URL it prints below and restart the API.
# 4. On Cloud Run, use the nox-api service URL instead; no tunnel.
WEBHOOK_BASE_URL=http://localhost:8000

# ── Atlassian: Jira + Confluence ────────────────────────────
ATLASSIAN_BASE_URL=https://yourco.atlassian.net
ATLASSIAN_EMAIL=                        # owner of the API token
JIRA_API_TOKEN=
CONFLUENCE_API_TOKEN=                   # usually the same token as Jira
JIRA_WEBHOOK_SECRET=                    # random string; also goes in the Jira webhook URL
JIRA_DEFAULT_PROJECT=APEX
JIRA_ALLOWED_PROJECTS=APEX              # comma-separated

# ── Notion / Slack (optional sources) ───────────────────────
NOTION_API_TOKEN=
NOTION_PARENT_PAGE_ID=                  # parent page for seeded demo pages
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Firebase ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=                    # defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID
NOX_TICKET_STORE=memory                 # firestore = ticket assignee + pipeline in Cloud Firestore

# ── NoX ─────────────────────────────────────────────────────
NOX_API_URL=http://localhost:8000       # where the web app proxies /api/v1 to
NEXT_PUBLIC_API_URL=                    # leave empty: the browser uses the web app's /api/v1 proxy
NOX_WEB_ORIGIN=http://localhost:3000    # CORS allow-list (comma-separated), for direct API callers
NOX_DEMO_ORG_SLUGS=apex                 # new users auto-join these orgs
NOX_DEV_AUTH=false                      # local only: accept "Authorization: Dev <email>"
NEXT_PUBLIC_NOX_DEV_AUTH=false          # local only: show the dev sign-in box on /login
NOX_COMMIT_SPECS=true                   # commit spec files to the app's KB repo
NOX_PUBLIC_API_URL=                     # public API URL for MCP (/mcp) and A2A (/a2a/ask); empty = WEBHOOK_BASE_URL
NOX_MCP_RATE_LIMIT=60                   # MCP tool calls per token per minute

# ── NoX Shield (Model Armor + Sensitive Data Protection) ────
NOX_SHIELD=off                          # off | monitor (record only) | enforce (production); always off for local
NOX_SHIELD_TEMPLATE=nox-shield          # Model Armor template id
NOX_SHIELD_LOCATION=us-central1         # Model Armor is regional

# ── Flight recorder (BigQuery) ──────────────────────────────
NOX_ANALYTICS=off                       # off | bigquery; the impact page falls back to Postgres when off
NOX_BQ_DATASET=nox_analytics

# ── Show NoX: screenshots, screen recordings, video and voice ────────────────
NOX_MEDIA_MAX_VIDEO_MB=200              # screen recordings and videos
NOX_MEDIA_MAX_AUDIO_MB=50
NOX_MEDIA_MAX_IMAGE_MB=10
NOX_MEDIA_MAX_VIDEO_S=300               # uploaded video; recordings made in NoX stop at 3:00
NOX_MEDIA_MAX_AUDIO_S=600
NOX_MEDIA_PER_MISSION=12
NOX_SHIELD=off                          # off | monitor | enforce: screens capture transcripts and on-screen text

# ── Sightings: changes NoX suggests per seat, on a schedule ─────────────────
# Celery beat checks for due runs every 15 minutes. Without beat, set NOX_SIGHTINGS_TICK=local (one API instance),
# or call POST /api/v1/internal/sightings/tick from a scheduler with the secret or an OIDC token.
NOX_SIGHTINGS_MAX_PER_SEAT=5
NOX_SIGHTINGS_TICK=off                  # off | local
NOX_SIGHTINGS_TICK_SECRET=              # X-Nox-Tick header value for the internal tick
NOX_SIGHTINGS_SCHEDULER_SA=             # a scheduler service account whose OIDC token may call the tick

# ── Pipeline tuning (defaults are fine) ─────────────────────
LOCAL_MAX_FILES=150
LOCAL_CHUNK_SIZE=6000
LOCAL_MAX_PAGES=6
LOCAL_PAGE_TOKEN_BUDGET=20000
REMOTE_SEMAPHORE_LIMIT=2
REMOTE_INLINE_THRESHOLD=2500000
REMOTE_MAX_PAGES=25
HYBRID_LOCAL_CATEGORIES=summaries,entities
HYBRID_REMOTE_CATEGORIES=concepts,decisions
HYBRID_MAX_LOCAL_FILES=150
HYBRID_ENABLE_SYNTHESIS_PASS=true

# ── CP20: agent tracing, team memory, voice, Jules ───────────────────────────
NOX_TRACE=off                           # off | console | cloud (Cloud Trace; the runtime account needs roles/cloudtrace.agent)
NOX_MEMORY=postgres                     # postgres | memory_bank (Agent Platform Memory Bank) | off
NOX_MEMORY_BANK=                        # projects/<p>/locations/<loc>/memoryBanks/<id>, printed by scripts/setup_memory_bank.py
NOX_MODEL_TRANSCRIBE=                   # speech to text; empty = NOX_MODEL_FAST (follows NoX's vocabulary best)
NOX_MODEL_TTS=gemini-3.8-flash-lite-tts # Listen button; empty hides it
NOX_TTS_VOICE=Kore
JULES_API_KEY=                          # jules.google.com → Settings → API; install the Jules GitHub app on your repos
